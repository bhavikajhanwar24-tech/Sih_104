# Copied to /opt/sentinelvoice-secrets/app.env on first boot. Not the live secret file.
# Passwords must stay equal to infra/postgres/init/01-roles.sql unless you recreate the DB volume.
# __PUBLIC_HOST__ is replaced with the instance public IP by user-data.

POSTGRES_DB=sentinelvoice
POSTGRES_USER=sv_bootstrap
POSTGRES_PASSWORD=changeme_bootstrap
SV_OWNER_PASSWORD=changeme_owner
SV_APP_PASSWORD=changeme_app
DB_APP_USER=sv_app
DB_APP_PASSWORD=changeme_app
DB_OWNER_USER=sv_owner
DB_OWNER_PASSWORD=changeme_owner
USE_SUPABASE=false

JWT_SECRET=dev-only-change-me-sentinelvoice-jwt-32b
COOKIE_SECURE=false
SENTINELVOICE_CORS_ORIGINS=http://__PUBLIC_HOST__
ML_SERVICE_TOKEN=dev-ml-service-token-change-me
APP_ENCRYPTION_KEY=dev-only-change-me-sentinelvoice-encryption-key
DIRECTORY_HMAC_SECRET=dev-directory-hmac-change-me
LLM_FORCE_MOCK=true
LAB_MODE=false
