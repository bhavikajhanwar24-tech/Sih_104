{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelvoice.local/contracts/ChallengeResult.schema.json",
  "title": "ChallengeResult",
  "description": "Server-measured challenge evaluation. Context §8.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sessionId",
    "nonce",
    "verdict",
    "latencyMs",
    "contentOverlap",
    "acousticCosine"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "sentinelvoice.ChallengeResult/1"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "nonce": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL_LATENCY",
        "FAIL_CONTENT",
        "FAIL_ACOUSTIC",
        "TIMEOUT"
      ]
    },
    "latencyMs": {
      "type": "number",
      "minimum": 0
    },
    "contentOverlap": {
      "$ref": "#/$defs/UnitInterval"
    },
    "acousticCosine": {
      "$ref": "#/$defs/UnitInterval"
    }
  },
  "$defs": {
    "ChannelProfile": {
      "type": "string",
      "enum": [
        "PSTN_NARROWBAND",
        "VOIP_WIDEBAND",
        "WEBRTC_WIDEBAND"
      ]
    },
    "InterventionLevel": {
      "type": "string",
      "enum": [
        "LEVEL_1_SILENT",
        "LEVEL_2_SOFT_NUDGE",
        "LEVEL_3_STEP_UP_MFA",
        "LEVEL_4_AUTO_HOLD",
        "LEVEL_5_TERMINATE"
      ]
    },
    "RiskState": {
      "type": "string",
      "enum": [
        "SCORED",
        "INSUFFICIENT_EVIDENCE",
        "DEGRADED"
      ]
    },
    "IdentityVerdict": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "INCONCLUSIVE",
        "IMPERSONATION_HUMAN",
        "IMPERSONATION_SYNTHETIC"
      ]
    },
    "Trend": {
      "type": "string",
      "enum": [
        "RISING",
        "FALLING",
        "STABLE"
      ]
    },
    "ReasonSeverity": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "UnitInterval": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
