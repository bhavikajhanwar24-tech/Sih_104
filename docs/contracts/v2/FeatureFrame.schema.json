{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelvoice.local/contracts/v2/FeatureFrame.schema.json",
  "title": "FeatureFrame",
  "description": "Inference Plane \u2192 Decision Plane. Emitted every 500 ms. No audio, no verbatim transcript beyond a short redacted snippet. Context \u00a78.1. [V2: required tenantId + schemaVersion=2.]",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tenantId",
    "schemaVersion",
    "sessionId",
    "seq",
    "windowStartMs",
    "windowEndMs",
    "channelProfile",
    "speechPresent",
    "cumulativeSpeechMs",
    "voice",
    "channel",
    "prosody",
    "speaker",
    "watermark",
    "linguistic",
    "latencyMs"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "sentinelvoice.FeatureFrame/1"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "windowStartMs": {
      "type": "integer",
      "minimum": 0
    },
    "windowEndMs": {
      "type": "integer",
      "minimum": 0
    },
    "channelProfile": {
      "$ref": "#/$defs/ChannelProfile"
    },
    "speechPresent": {
      "type": "boolean"
    },
    "cumulativeSpeechMs": {
      "type": "integer",
      "minimum": 0
    },
    "voice": {
      "$ref": "#/$defs/VoiceFamily"
    },
    "channel": {
      "$ref": "#/$defs/ChannelFamily"
    },
    "prosody": {
      "$ref": "#/$defs/ProsodyFamily"
    },
    "speaker": {
      "$ref": "#/$defs/SpeakerFamily"
    },
    "watermark": {
      "$ref": "#/$defs/WatermarkFamily"
    },
    "linguistic": {
      "$ref": "#/$defs/LinguisticFamily"
    },
    "latencyMs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fastPath",
        "slowPath"
      ],
      "properties": {
        "fastPath": {
          "type": "number",
          "minimum": 0
        },
        "slowPath": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "description": "Tenant that owns this message (V2 multi-tenancy)."
    },
    "schemaVersion": {
      "type": "string",
      "const": "2",
      "description": "Wire contract major version. V2 schemas use const \"2\"."
    }
  },
  "$defs": {
    "ChannelProfile": {
      "type": "string",
      "enum": [
        "PSTN_NARROWBAND",
        "VOIP_WIDEBAND",
        "WEBRTC_WIDEBAND"
      ]
    },
    "InterventionLevel": {
      "type": "string",
      "enum": [
        "LEVEL_1_SILENT",
        "LEVEL_2_SOFT_NUDGE",
        "LEVEL_3_STEP_UP_MFA",
        "LEVEL_4_AUTO_HOLD",
        "LEVEL_5_TERMINATE"
      ]
    },
    "RiskState": {
      "type": "string",
      "enum": [
        "SCORED",
        "INSUFFICIENT_EVIDENCE",
        "DEGRADED"
      ]
    },
    "IdentityVerdict": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "INCONCLUSIVE",
        "IMPERSONATION_HUMAN",
        "IMPERSONATION_SYNTHETIC"
      ]
    },
    "Trend": {
      "type": "string",
      "enum": [
        "RISING",
        "FALLING",
        "STABLE"
      ]
    },
    "ReasonSeverity": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "UnitInterval": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "VoiceFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "spoofProbability": {
          "$ref": "#/$defs/UnitInterval"
        },
        "modelId": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/UnitInterval"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "available": {
                "const": true
              }
            },
            "required": [
              "available"
            ]
          },
          "then": {
            "required": [
              "spoofProbability",
              "modelId",
              "confidence"
            ]
          }
        }
      ]
    },
    "ChannelFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "rirT60Ms": {
          "type": "number"
        },
        "rirPlausible": {
          "type": "boolean"
        },
        "doubleCompressionScore": {
          "$ref": "#/$defs/UnitInterval"
        },
        "noiseFloorStationarity": {
          "$ref": "#/$defs/UnitInterval"
        },
        "dcOffset": {
          "type": "number"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "available": {
                "const": true
              }
            },
            "required": [
              "available"
            ]
          },
          "then": {
            "required": [
              "rirT60Ms",
              "rirPlausible",
              "doubleCompressionScore",
              "noiseFloorStationarity",
              "dcOffset"
            ]
          }
        }
      ]
    },
    "ProsodyFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "f0MeanHz": {
          "type": "number"
        },
        "f0StdHz": {
          "type": "number"
        },
        "jitterLocalPct": {
          "type": "number"
        },
        "shimmerLocalPct": {
          "type": "number"
        },
        "hnrDb": {
          "type": "number"
        },
        "breathEventsPerMin": {
          "type": "number"
        },
        "disfluencyRate": {
          "type": "number"
        },
        "articulationRateSylSec": {
          "type": "number"
        },
        "unnaturalnessScore": {
          "$ref": "#/$defs/UnitInterval"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "available": {
                "const": true
              }
            },
            "required": [
              "available"
            ]
          },
          "then": {
            "required": [
              "f0MeanHz",
              "f0StdHz",
              "jitterLocalPct",
              "shimmerLocalPct",
              "hnrDb",
              "breathEventsPerMin",
              "disfluencyRate",
              "articulationRateSylSec",
              "unnaturalnessScore"
            ]
          }
        }
      ]
    },
    "SpeakerFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "embeddingId": {
          "type": "string"
        },
        "enrolledProfileId": {
          "type": [
            "string",
            "null"
          ]
        },
        "cosineSimilarity": {
          "$ref": "#/$defs/UnitInterval"
        },
        "intraCallDrift": {
          "$ref": "#/$defs/UnitInterval"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "available": {
                "const": true
              }
            },
            "required": [
              "available"
            ]
          },
          "then": {
            "required": [
              "embeddingId",
              "enrolledProfileId",
              "cosineSimilarity",
              "intraCallDrift"
            ]
          }
        }
      ]
    },
    "WatermarkFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "detector": {
          "type": "string"
        },
        "detected": {
          "type": "boolean"
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/UnitInterval"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "available": {
                "const": true
              }
            },
            "required": [
              "available"
            ]
          },
          "then": {
            "required": [
              "detector",
              "detected",
              "provider",
              "confidence"
            ]
          }
        }
      ]
    },
    "Ask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "Ask type enum (WIRE_TRANSFER, OTP_SHARE, PIN_SHARE, PASSWORD_RESET, INFO, OTHER)."
        },
        "amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "beneficiaryHint": {
          "type": [
            "string",
            "null"
          ],
          "description": "Deprecated for F11 wire (prefer beneficiaryMentioned bool). Optional for back-compat fixtures."
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ]
        },
        "sharesCredential": {
          "type": "boolean"
        },
        "beneficiaryMentioned": {
          "type": "boolean"
        }
      }
    },
    "LinguisticCategories": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "URGENCY": { "$ref": "#/$defs/UnitInterval" },
        "SECRECY": { "$ref": "#/$defs/UnitInterval" },
        "AUTHORITY": { "$ref": "#/$defs/UnitInterval" },
        "PAYMENT": { "$ref": "#/$defs/UnitInterval" },
        "CREDENTIAL": { "$ref": "#/$defs/UnitInterval" },
        "CUSTOM": { "$ref": "#/$defs/UnitInterval" }
      }
    },
    "LinguisticFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "enum": ["STAGE_A", "STAGE_B", "MERGED"],
          "description": "F11 — which extractor produced this snapshot."
        },
        "observedAt": {
          "type": "integer",
          "minimum": 0,
          "description": "Unix epoch milliseconds when extraction was observed."
        },
        "ageMs": {
          "type": "integer",
          "minimum": 0
        },
        "confidence": {
          "$ref": "#/$defs/UnitInterval"
        },
        "language": {
          "type": "string"
        },
        "urgency": {
          "$ref": "#/$defs/UnitInterval"
        },
        "secrecy": {
          "$ref": "#/$defs/UnitInterval"
        },
        "authorityInvocation": {
          "$ref": "#/$defs/UnitInterval"
        },
        "emotionalCoercion": {
          "$ref": "#/$defs/UnitInterval"
        },
        "askDetected": {
          "type": "boolean"
        },
        "ask": {
          "$ref": "#/$defs/Ask"
        },
        "categories": {
          "$ref": "#/$defs/LinguisticCategories"
        },
        "matchedRuleIds": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 16
        },
        "injectionAttempt": {
          "type": "boolean",
          "description": "True when transcript contained instruction-like phrases aimed at an AI."
        },
        "llmPending": {
          "type": "boolean",
          "description": "True while an async Stage B call is in flight."
        },
        "claimedIdentity": {
          "type": [
            "string",
            "null"
          ],
          "description": "Deprecated on wire for F11 privacy — prefer role tokens only."
        },
        "claimedRole": {
          "type": [
            "string",
            "null"
          ]
        },
        "redactedSnippet": {
          "type": "string",
          "description": "F11: MUST NOT be emitted on live sessions (in-memory only). Optional for demo fixtures."
        },
        "redactedDelta": {
          "type": "string",
          "description": "F11: MUST NOT be emitted on live sessions."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "available": {
                "const": true
              }
            },
            "required": [
              "available"
            ]
          },
          "then": {
            "required": [
              "ageMs",
              "language",
              "urgency",
              "secrecy",
              "authorityInvocation",
              "emotionalCoercion",
              "askDetected",
              "source",
              "confidence",
              "injectionAttempt"
            ]
          }
        }
      ]
    }
  }
}
