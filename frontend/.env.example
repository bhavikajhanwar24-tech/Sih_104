# =============================================================================
# SentinelVoice Frontend Environment Configuration
# =============================================================================
#
# LOCAL DEVELOPMENT:
# In local development, the Vite proxy handles /api and /ws-sentinel forwarding
# to http://127.0.0.1:8081 automatically. You can leave these variables empty.
#
# PRODUCTION (VERCEL DEPLOYMENT):
# Set VITE_API_BASE_URL to your deployed Render backend URL:
# Example:
# VITE_API_BASE_URL=https://sentinelvoice-backend.onrender.com
#
# WebSocket STOMP URL is automatically derived as wss://.../ws-sentinel
# when VITE_API_BASE_URL is provided. You can override it explicitly if needed:
# VITE_STOMP_URL=wss://sentinelvoice-backend.onrender.com/ws-sentinel
#
# Optional ML Engine / Inference Plane URL:
# VITE_ENGINE_BASE_URL=https://sentinelvoice-ml.onrender.com
# =============================================================================

VITE_API_BASE_URL=
VITE_STOMP_URL=
VITE_ENGINE_BASE_URL=
