# SentinelVoice local secrets — copy to `.env` and change passwords.
# Never commit `.env`.

POSTGRES_DB=sentinelvoice
# Bootstrap superuser used only by the postgres image entrypoint / init scripts
POSTGRES_USER=sv_bootstrap
POSTGRES_PASSWORD=changeme_bootstrap

# Migration owner (Flyway). Owns tables; may ALTER.
SV_OWNER_PASSWORD=changeme_owner

# Application role (HikariCP). No superuser, no BYPASSRLS, cannot ALTER.
SV_APP_PASSWORD=changeme_app

# JDBC (Decision Plane)
DB_URL=jdbc:postgresql://127.0.0.1:15432/sentinelvoice?options=-c%20TimeZone%3DUTC
DB_APP_USER=sv_app
DB_APP_PASSWORD=changeme_app
DB_OWNER_USER=sv_owner
DB_OWNER_PASSWORD=changeme_owner

# Auth (F2) — must be >= 32 bytes
JWT_SECRET=dev-only-change-me-sentinelvoice-jwt-32b
COOKIE_SECURE=false
SENTINELVOICE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Shared secret for ml-engine → Java /ws/features (min 16 chars)
ML_SERVICE_TOKEN=dev-ml-service-token-change-me

# Directory beneficiary HMAC key (optional; falls back to JWT_SECRET)
DIRECTORY_HMAC_SECRET=dev-directory-hmac-change-me
