# SentinelVoice local / compose environment (copy to .env — never commit secrets).
# Compose and scripts read these; application code binds via Spring ${ENV:default} only.

# Decision Plane
SENTINELVOICE_ML_BASE_URL=http://ml-engine:8000
SENTINELVOICE_ML_WEBSOCKET_URL=ws://ml-engine:8000/ingest
SENTINELVOICE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Inference Plane → Decision Plane
SENTINELVOICE_ML_JAVA_INGEST_WS=ws://backend:8080/ws/features
SENTINELVOICE_ML_JAVA_DECISION_HTTP=http://backend:8080
SENTINELVOICE_ML_JAVA_PASSPORT_URL=http://backend:8080/api/v1/passport/register

# Optional postgres profile (compose service `postgres` when enabled)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sentinelvoice
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel

# Demo HTTP Basic users (password for all): password
# Roles: analyst / supervisor / compliance / admin
