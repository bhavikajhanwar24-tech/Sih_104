# SentinelVoice local secrets — copy to `.env` and change passwords.
# Never commit `.env`.

POSTGRES_DB=sentinelvoice
# Bootstrap superuser used only by the postgres image entrypoint / init scripts
POSTGRES_USER=sv_bootstrap
POSTGRES_PASSWORD=changeme_bootstrap

# Migration owner (Flyway). Owns tables; may ALTER.
SV_OWNER_PASSWORD=changeme_owner

# Application role (HikariCP). No superuser, no BYPASSRLS, cannot ALTER.
SV_APP_PASSWORD=changeme_app

# ---------------------------------------------------------------------------
# Database — deployed central DB is Supabase (docs/v2/SUPABASE.md).
# Local Docker Postgres: docker compose up -d postgres
# Migrate local → Supabase: .\scripts\migrate-to-supabase.ps1
# ---------------------------------------------------------------------------
USE_SUPABASE=false

# Supabase Session Pooler URI (port 5432). Required when migrating / using cloud DB.
# Dashboard → Connect → Session pooler. Always include sslmode=require.
# SUPABASE_DB_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
# SUPABASE_DB_PASSWORD=

# JDBC (Decision Plane)
# Local:
DB_URL=jdbc:postgresql://127.0.0.1:15432/sentinelvoice?options=-c%20TimeZone%3DUTC
DB_APP_USER=sv_app
DB_APP_PASSWORD=changeme_app
DB_OWNER_USER=sv_owner
DB_OWNER_PASSWORD=changeme_owner
# Supabase (when USE_SUPABASE=true) — uncomment and fill:
# DB_URL=jdbc:postgresql://aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require&options=-c%20TimeZone%3DUTC
# DB_APP_USER=sv_app.<PROJECT_REF>
# DB_APP_PASSWORD=<same as SV_APP_PASSWORD>
# DB_OWNER_USER=postgres.<PROJECT_REF>
# DB_OWNER_PASSWORD=<SUPABASE_DB_PASSWORD>

# Auth (F2) — must be >= 32 bytes
JWT_SECRET=dev-only-change-me-sentinelvoice-jwt-32b
COOKIE_SECURE=false
SENTINELVOICE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Shared secret for ml-engine ↔ Java /ws/features and /llm/v1/* (min 16 chars).
# ml-engine also accepts this as SENTINELVOICE_ML_SERVICE_TOKEN (auto-aliased from .env).
ML_SERVICE_TOKEN=dev-ml-service-token-change-me

# F5 LLM gateway (Inference Plane router — not the 500ms path)
LLM_GATEWAY_URL=http://127.0.0.1:8000
# Host process: 127.0.0.1. If ml-engine runs in Docker against host Ollama, use
# http://host.docker.internal:11434 instead.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
# Concurrent Ollama generations (1 is safest for small CPU/GPU models)
LLM_GATEWAY_CONCURRENCY=1
LLM_GATEWAY_QUEUE_MAX=32
LLM_OPENAI_COMPAT_ENABLED=false
# LLM_OPENAI_COMPAT_BASE_URL=
# LLM_OPENAI_COMPAT_API_KEY=
# LLM_OPENAI_COMPAT_MODEL=gpt-4o-mini
# Used automatically when Ollama is unreachable
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai
LLM_FORCE_MOCK=false

# Directory beneficiary HMAC key (optional; falls back to JWT_SECRET)
DIRECTORY_HMAC_SECRET=dev-directory-hmac-change-me

# F9 — AES-GCM key for tenant integration secrets at rest (any passphrase; SHA-256 derived)
APP_ENCRYPTION_KEY=dev-only-change-me-sentinelvoice-encryption-key

# F10 — Multi-tenant telephony (PJSIP REALTIME)
# Softphones need the host LAN IPv4 in SIP_EXTERNAL_IP (see scripts/detect-lan-ip.*).
SIP_EXTERNAL_IP=
SIP_LOCAL_NET=127.0.0.1/32
# Asterisk → Postgres (role sv_asterisk, schema asterisk only — password also in V017 note)
ASTERISK_DB_HOST=host.docker.internal
ASTERISK_DB_PORT=15432
ASTERISK_DB_NAME=sentinelvoice
ASTERISK_DB_USER=sv_asterisk
ASTERISK_DB_PASSWORD=changeme_asterisk
PGSSLMODE=prefer
# When app DB is Supabase, mirror ps_* to local Docker Postgres for Asterisk:
ASTERISK_SYNC_URL=jdbc:postgresql://127.0.0.1:15432/sentinelvoice
ASTERISK_SYNC_USER=sv_bootstrap
ASTERISK_SYNC_PASSWORD=changeme_bootstrap
# Host-run Decision Plane → published ports (never Docker service DNS names)
ASTERISK_AMI_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=sentinel
ASTERISK_AMI_SECRET=sentineldemo
ASTERISK_ARI_BASE_URL=http://127.0.0.1:8088/ari
ASTERISK_ARI_USER=sentinel
ASTERISK_ARI_PASSWORD=sentineldemo
SV_BACKEND_URL=http://host.docker.internal:8081
# Lab attacker SIP endpoints allowed when true; refused under Spring profile prod
LAB_MODE=false
